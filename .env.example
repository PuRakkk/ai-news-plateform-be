APP_ENV=development
APP_TIMEZONE=Asia/Phnom_Penh
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_news_db
ADMIN_AUTH_SECRET=dev_admin_secret_key_1234567890
JWT_SECRET=dev_jwt_secret_key_1234567890_abcdefg
JWT_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=ai_news_auth
AUTH_COOKIE_SECURE=false
FRONTEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_ENCRYPTION_KEY=

# Redis & Background Tasks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Scheduler Configuration (Daily Cron Trigger Time)
SCHEDULER_ENABLED=true
SCHEDULER_CRON_HOUR=7
SCHEDULER_CRON_MINUTE=0
SCHEDULER_RUN_ON_STARTUP=false

# Ingestion Freshness & Limits
RSS_MAX_ENTRIES_PER_FEED=25
RSS_MAX_AGE_DAYS=3
RSS_ONLY_YESTERDAY_AND_TODAY=true
RSS_TODAY_FRESHNESS_BONUS=0.05

# AI Model Provider (gemini | openai | claude)
LLM_PROVIDER=openai
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Media Storage Provider (local | s3 | r2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=media
STORAGE_BASE_URL=http://localhost:8000/media
# S3 / Cloudflare R2 Credentials (for Production)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=ai-news-media
S3_PUBLIC_BASE_URL=

# Video Generation Engine (mock | programmatic | heygen | did)
VIDEO_ENGINE=mock
VIDEO_ASPECT_RATIO=16:9
HEYGEN_API_KEY=
HEYGEN_TEST_MODE=false
ELEVENLABS_API_KEY=


